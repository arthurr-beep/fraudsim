# Copy to .env and fill in what you need, then load it with Node's built-in
# flag, e.g.:
#   node --env-file=.env examples/adaptive-attacker-demo/index.js
#
# Every key is optional. Without an LLM key the adaptive attacker uses the
# deterministic provider.

# The adaptive-attacker demo uses the first of these that is set.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# The system under test. Each example has its own default port, so leave this
# unset to use it. Only point fraud-sim at systems you own or have written
# permission to test.
# TARGET_URL=https://staging.example.com
# API_KEY=
