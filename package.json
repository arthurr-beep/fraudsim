{
  "name": "fraud-sim",
  "version": "0.5.1",
  "description": "Realistic synthetic attack traffic for testing fintech fraud detection systems",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./adapters": {
      "types": "./types/adapters/index.d.ts",
      "default": "./src/adapters/index.js"
    },
    "./streaming": {
      "types": "./types/streaming/index.d.ts",
      "default": "./src/streaming/index.js"
    },
    "./llm": {
      "types": "./types/llm/index.d.ts",
      "default": "./src/llm/index.js"
    },
    "./utils": {
      "types": "./types/utils/index.d.ts",
      "default": "./src/utils/index.js"
    },
    "./reporting": {
      "types": "./types/reporting/index.d.ts",
      "default": "./src/reporting/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin/",
    "src/",
    "types/",
    "examples/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "cd test/unit && node --test",
    "test:integration": "cd test/integration && node --test",
    "test:all": "cd test && node --test",
    "test:e2e": "node --test test/e2e/walkthrough.e2e.js",
    "demo": "node --test-reporter=spec test/e2e/walkthrough.e2e.js",
    "demo:npm": "node --test-reporter=spec test/e2e/walkthrough.e2e.js --from-npm",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "example:basic": "node examples/basic-credential-stuffing/index.js",
    "example:drain": "node examples/account-drain-demo/index.js",
    "example:mock-target": "node examples/express-mock-target/server.js",
    "example:hardened-target": "node examples/express-hardened-target/server.js",
    "example:adaptive-target": "node examples/adaptive-attacker-demo/demo-target.js",
    "example:adaptive": "node examples/adaptive-attacker-demo/index.js",
    "build:types": "tsc",
    "prepublishOnly": "npm run build:types && npm run lint && npm run test:all",
    "example:adaptive-hardened": "node examples/adaptive-hardened-demo/index.js"
  },
  "keywords": [
    "fraud",
    "fraud-detection",
    "security-testing",
    "fintech",
    "simulation",
    "adversarial-testing",
    "penetration-testing"
  ],
  "author": "Arthur (@arthurr-beep) <arthurraugustus@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arthurr-beep/fraudsim.git"
  },
  "bugs": {
    "url": "https://github.com/arthurr-beep/fraudsim/issues"
  },
  "homepage": "https://github.com/arthurr-beep/fraudsim#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "express": "^5.3.0",
    "globals": "^17.11.0",
    "typescript": "^7.0.2"
  },
  "types": "./types/index.d.ts",
  "bin": {
    "fraud-sim": "bin/fraud-sim.js"
  }
}
