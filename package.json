{
  "name": "fraud-sim",
  "version": "0.2.0",
  "description": "Realistic synthetic attack traffic for testing fintech fraud detection systems",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./adapters": "./src/adapters/index.js",
    "./streaming": "./src/streaming/index.js",
    "./llm": "./src/llm/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "src/",
    "examples/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "cd test/unit && node --test",
    "test:integration": "cd test/integration && node --test",
    "test:all": "cd test && node --test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "example:basic": "node examples/basic-credential-stuffing/index.js",
    "example:drain": "node examples/account-drain-demo/index.js",
    "example:mock-target": "node examples/express-mock-target/server.js",
    "example:adaptive-target": "node examples/adaptive-attacker-demo/demo-target.js",
    "example:adaptive": "node examples/adaptive-attacker-demo/index.js"
  },
  "keywords": [
    "fraud",
    "fraud-detection",
    "security-testing",
    "fintech",
    "simulation",
    "adversarial-testing",
    "penetration-testing"
  ],
  "author": "Arthur (@arthurr-beep) <arthurraugustus@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/arthurr-beep/fraudsim.git"
  },
  "bugs": {
    "url": "https://github.com/arthurr-beep/fraudsim/issues"
  },
  "homepage": "https://github.com/arthurr-beep/fraudsim#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "express": "^5.2.1",
    "globals": "^17.11.0"
  }
}
